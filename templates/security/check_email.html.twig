{% extends 'base.html.twig' %}

{% block title %}Check Your Email - TaskPark{% endblock %}

{% block nav_right %}{% endblock %}

{% block body %}
<div class="min-h-[calc(100vh-8rem)] flex items-center justify-center px-4 py-12">
    <div class="max-w-md w-full space-y-8 text-center">
        {# Email icon #}
        <div>
            <span class="text-6xl">📧</span>
        </div>

        {# Message #}
        <div class="bg-surface rounded-xl shadow-lg p-8">
            <h1 class="text-2xl font-bold text-text mb-4">Check your email</h1>

            <p class="text-text-light mb-6">
                We've sent a magic link to
                {% if email %}
                    <span class="font-medium text-text">{{ email }}</span>
                {% else %}
                    your email address
                {% endif %}
            </p>

            <div class="bg-slate-50 rounded-lg p-4 mb-6">
                <p class="text-sm text-text-light">
                    Click the link in the email to sign in. The link will expire in 15 minutes.
                </p>
            </div>

            <div class="space-y-3">
                <p class="text-sm text-text-light">
                    Didn't receive the email?
                </p>
                <a
                    href="{{ path('app_login') }}"
                    class="inline-block text-primary hover:text-primary-dark font-medium"
                >
                    Try again
                </a>
            </div>
        </div>

        {# Tips #}
        <div class="text-sm text-text-light space-y-1">
            <p>Check your spam folder if you don't see it</p>
            <p>Make sure you entered the correct email</p>
        </div>
    </div>
</div>
{% endblock %}
