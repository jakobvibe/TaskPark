<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}TaskPark{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🌿</text></svg>">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="min-h-screen flex flex-col">
        {# Navigation Header #}
        <header class="bg-surface shadow-sm border-b border-slate-200">
            <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex justify-between items-center h-16">
                    <a href="{{ path('app_dashboard') }}" class="flex items-center gap-2 text-xl font-semibold text-primary hover:text-primary-dark">
                        <span>🌿</span>
                        <span>TaskPark</span>
                    </a>

                    {% block nav_right %}
                        {% if app.user %}
                            <div class="flex items-center gap-4">
                                <span class="text-text-light text-sm">{{ app.user.name ?? app.user.email }}</span>
                                <form action="{{ path('app_logout') }}" method="post">
                                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                                    <button type="submit" class="btn text-sm text-text-light hover:text-danger px-3 py-1.5 rounded-md hover:bg-slate-100">
                                        Logout
                                    </button>
                                </form>
                            </div>
                        {% endif %}
                    {% endblock %}
                </div>
            </nav>
        </header>

        {# Main Content #}
        <main class="flex-1">
            {% block body %}{% endblock %}
        </main>

        {# Footer #}
        <footer class="bg-surface border-t border-slate-200 py-4">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-text-light text-sm">
                TaskPark - Take it one task at a time
            </div>
        </footer>

        {# Flash Messages #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="fixed bottom-4 right-4 p-4 rounded-lg shadow-lg {% if label == 'success' %}bg-success text-white{% elseif label == 'error' %}bg-danger text-white{% else %}bg-primary text-white{% endif %}"
                     data-controller="flash"
                     data-flash-hide-after-value="5000">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}
    </body>
</html>
